---
import '../styles/global.css';
import Forecast from '../components/Forecast.astro';
import Outlook from '../components/Outlook.astro';
import Pressure from '../components/Pressure.astro';
import Rainfall from '../components/Rainfall.astro';
import Wind from '../components/Wind.astro';
import Climate from '../components/Climate.astro';
import Sources from '../components/Sources.astro';
import { read, configuration, age, date } from '../lib/data';
const config = configuration();
const tabs = [{id:'forecast',label:'Forecast'},{id:'outlook',label:'15 days'},{id:'pressure',label:'Pressure'},{id:'rainfall',label:'Rainfall'},{id:'wind',label:'Wind'},{id:'climate',label:'Climate change'}];
const requested = Astro.url.searchParams.get('tab');
const tab = requested==='sources' ? 'sources' : tabs.find(t=>t.id===requested)?.id || 'forecast';
const city = config.cities.find((c:any)=>c.id===Astro.url.searchParams.get('city')) || config.cities[0];
const cycle = Astro.url.searchParams.get('cycle')==='1';
const link = (target:string,extra:Record<string,string>={})=>'/?'+new URLSearchParams({city:city.id,tab:target,...(cycle?{cycle:'1'}:{}),...extra}).toString();
const load = (file:string)=>read(`cities/${city.id}/${file}.json`);
const forecast = load('forecast');
const ecmwf = load('ecmwf_ifs025_ensemble');
const gfs = load('ncep_gefs_seamless');
const rainfall = load('rainfall');
const climate = load('climate');
const pressure = read('pressure.json');
const status = read('status.json');
const sources = tab==='climate' ? [climate] : tab==='outlook' ? [ecmwf,gfs] : tab==='pressure' ? [pressure] : tab==='rainfall' ? [rainfall] : [forecast];
const updated = sources.filter(Boolean).map((s:any)=>s.updated).sort()[0];
const threshold = (tab==='rainfall'||tab==='climate')?36:tab==='pressure'?24:12;
const stale = updated && Date.now()-Date.parse(updated)>threshold*3600000;
const nextTab = tabs[(tabs.findIndex(t=>t.id===tab)+1)%tabs.length].id;
const refresh = cycle ? `120;url=${link(nextTab)}` : '1800';
const today = date(new Date().toISOString(),city.timezone,{weekday:'long',day:'numeric',month:'long',year:'numeric'});
const activeJobs=[`${city.id}:forecast`,`${city.id}:ecmwf_ifs025_ensemble`,`${city.id}:ncep_gefs_seamless`,`${city.id}:rainfall:openmeteo:v1`,'pressure:openmeteo:v1',`${city.id}:climate:era5:v1`];
const errors = status?.jobs?.filter((j:any)=>j.error&&activeJobs.includes(j.name))||[];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="A quiet, regional weather dashboard designed for e-ink."/><meta http-equiv="refresh" content={refresh}/><title>{city.name} weather · Better Meteo</title></head>
<body><div class="dashboard">
  <header><a href={link('forecast')} class="wordmark"><span class="brand-icon" aria-hidden="true">◒</span> better meteo<span class="brand-caption">A QUIETER LOOK AT THE WEATHER</span></a><form method="get"><input type="hidden" name="tab" value={tab}/>{cycle&&<input type="hidden" name="cycle" value="1"/>}<label for="city" class="sr-only">Location</label><select id="city" name="city">{config.cities.map((c:any)=><option value={c.id} selected={c.id===city.id}>{c.name}</option>)}</select><button type="submit">Set city</button></form></header>
  <div class="location-line"><div><span class="eyebrow">YOUR REGIONAL WEATHER</span><h1>{city.name}<span class="coordinates">{city.latitude.toFixed(2)}° N · {city.longitude.toFixed(2)}° E</span></h1></div><div class="date-block"><strong>{today}</strong><span>{age(updated)}{stale?' · STALE':''}</span></div></div>
  <nav class="tabs" aria-label="Weather views">{tabs.map((t,i)=><a href={link(t.id)} aria-current={tab===t.id?'page':undefined}><span class="tab-number">0{i+1}</span>{t.label}</a>)}</nav>
  <main id="weather" class={`view-${tab}`}>
  {stale&&<p class="notice">Older saved data · check the dates. Updates respect the collection schedule.</p>}
  {tab==='forecast'&&<Forecast forecast={forecast} city={city}/>}
  {tab==='outlook'&&<Outlook ecmwf={ecmwf} gfs={gfs} city={city}/>}
  {tab==='pressure'&&<Pressure pressure={pressure} city={city} selected={Astro.url.searchParams.get('step')} playing={Astro.url.searchParams.get('motion')==='on'} link={link} ecmwf={ecmwf} gfs={gfs}/>}
  {tab==='rainfall'&&<Rainfall rainfall={rainfall} city={city}/>}
  {tab==='wind'&&<Wind forecast={forecast} city={city}/>}
  {tab==='climate'&&<Climate climate={climate} city={city} link={link} view={Astro.url.searchParams.get('view')} page={Astro.url.searchParams.get('page')}/>}
  {tab==='sources'&&<Sources status={status} errors={errors} forecast={forecast} ecmwf={ecmwf} gfs={gfs} rainfall={rainfall} climate={climate} pressure={pressure}/>}
  </main>
  <footer><span><a href="https://open-meteo.com/">Open-Meteo · CC BY 4.0</a></span><a href={link('sources')}>Sources & status{errors.length?` · ${errors.length} issue(s)`:''}</a><a href={cycle?'/?'+new URLSearchParams({city:city.id,tab}):link(tab,{cycle:'1'})}>{cycle?'Stop rotation':'Rotate tabs'}</a></footer>
</div></body></html>
