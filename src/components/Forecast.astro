---
import Empty from './Empty.astro';
import { number as n, date, weather } from '../lib/data';
const { forecast, city } = Astro.props;
const daily = forecast?.data?.daily;
const current = forecast?.data?.current;
const localToday = new Intl.DateTimeFormat('sv-SE',{timeZone:city.timezone,year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
---
{daily ? <>
  <section class="current strip">
    <div><span class="eyebrow">AT A GLANCE · MODEL CONDITIONS</span><div class="temperature">{n(current?.temperature_2m)}<span>°C</span></div><p>{current?.weather_code != null ? weather(current.weather_code) : 'Conditions unavailable'} · feels like {n(current?.apparent_temperature)}°</p><p class="muted">Model time: {current?.time?.replace('T',' ')||'unavailable'}</p></div>
    <div class="current-right"><span class="eyebrow">{daily.time[0]===localToday?'TODAY':date(daily.time[0],city.timezone)}</span><p class="large">{n(daily.temperature_2m_min[0])}° <span class="muted">/</span> {n(daily.temperature_2m_max[0])}°</p><p>Low / High</p><div class="mini-metrics"><span>{n(daily.precipitation_probability_max[0])}%<small>Precipitation chance</small></span><span>{n(daily.precipitation_sum[0],1)}<small>Precipitation · mm</small></span><span>{n(daily.snowfall_sum[0],1)}<small>Snow · cm</small></span></div></div>
  </section>
  <section class="forecast-week"><div class="section-line"><h2>The week ahead</h2><span>°C · mm · local dates</span></div>
  <div class="week">{daily.time.slice(0,7).map((day: string,i: number)=><article class="day-card"><h3>{day===localToday?'Today':date(day,city.timezone,{weekday:'short'})}</h3><p class="muted">{date(day,city.timezone,{day:'numeric',month:'short'})}</p><p class="condition">{daily.weather_code[i]!=null ? weather(daily.weather_code[i]):'—'}</p><div class="day-temp">{n(daily.temperature_2m_max[i])}° <span>{n(daily.temperature_2m_min[i])}°</span></div><p>{n(daily.precipitation_sum[i],1)} mm</p><p class="muted">{n(daily.precipitation_probability_max[i])}% precip.</p><p class="muted">Snow {n(daily.snowfall_sum[i],1)} cm</p></article>)}</div>
  </section>
  <p class="note">The first days show local detail. Use “15 days” for the range of possible outcomes further ahead.</p>
</> : <Empty />}
